# ---------------------------------------------------------------------------
# Author Reach Studio — environment variable TEMPLATE
# Copy to .env.local for local development. NEVER commit real values.
# Configure production values in Netlify > Site configuration > Environment variables.
# ---------------------------------------------------------------------------

# --- Supabase (browser-safe) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Legacy projects use NEXT_PUBLIC_SUPABASE_ANON_KEY instead — use ONE, not both.

# --- Supabase (SERVER ONLY — never prefix with NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_OR_SECRET_KEY
# SUPABASE_DB_PASSWORD=   # only for migrations/maintenance; store in a secret manager

# --- Paystack ---
PAYSTACK_SECRET_KEY=sk_test_xxx            # server only
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx  # only if using Paystack Inline JS
# Webhook HMAC uses PAYSTACK_SECRET_KEY (Paystack signs with the secret key).
NEXT_PUBLIC_PAYSTACK_MODE=test             # test | live

# --- Email / transactional notifications ---
EMAIL_PROVIDER=resend                      # resend | postmark | supabase-smtp
EMAIL_API_KEY=
EMAIL_FROM="Author Reach Studio <hello@yourdomain.com>"

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development            # development | staging | production
NEXT_PUBLIC_DEMO_MODE=true                 # set false once Supabase is connected

# --- Optional / later phases ---
# SENTRY_DSN=
# UPSTASH_REDIS_REST_URL=                  # rate limiting
