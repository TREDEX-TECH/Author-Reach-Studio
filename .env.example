# ---------------------------------------------------------------------------
# Author Reach Studio — environment variable TEMPLATE.
# Copy to .env.local for local development. NEVER commit real values.
# Configure production values in Netlify > Site configuration > Environment variables.
# ---------------------------------------------------------------------------

# --- Supabase (browser-safe) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# --- Supabase (SERVER ONLY — never prefix with NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_OR_SECRET_KEY
# SUPABASE_DB_PASSWORD=   # only for migrations/maintenance; keep in a secret manager

# --- Paystack ---
PAYSTACK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx
NEXT_PUBLIC_PAYSTACK_MODE=test
# Webhook HMAC uses PAYSTACK_SECRET_KEY (Paystack signs with the secret key).

# --- Email / transactional notifications ---
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM="Author Reach Studio <hello@yourdomain.com>"

# --- Public contact details (shown in footer, contact, legal and invoices) ---
NEXT_PUBLIC_CONTACT_EMAIL=hello@yourdomain.com
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=

# --- App ---
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_APP_ENV=production

# Hard sign-in wall for /portal, /workspace, /admin.
# Leave false while there are no user accounts; set true once accounts exist.
REQUIRE_AUTH=false

# --- Optional ---
# SENTRY_DSN=
# UPSTASH_REDIS_REST_URL=
